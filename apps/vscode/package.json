{
  "name": "localleaf",
  "displayName": "LocalLeaf",
  "description": "Local visual LaTeX editing with PDF and DOCX export (alpha)",
  "version": "0.1.0",
  "publisher": "localleaf",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "localleaf.open",
        "title": "LocalLeaf: Open LaTeX Editor",
        "icon": "$(edit)"
      }
    ],
    "configuration": {
      "title": "LocalLeaf",
      "properties": {
        "localleaf.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python interpreter with LocalLeaf installed (use python on Windows)."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "localleaf.open",
          "when": "resourceExtname == .tex",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "localleaf.open",
          "when": "resourceExtname == .tex"
        }
      ]
    }
  }
}
