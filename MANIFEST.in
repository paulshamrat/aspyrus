include package.json package-lock.json eslint.config.js .prettierrc.json .prettierignore
include CONTRIBUTING.md CHANGELOG.md SECURITY.md AGENTS.md
recursive-include packages/editor *.js *.json *.html *.css
recursive-include scripts *.mjs
recursive-include apps/vscode *.cjs *.json *.md LICENSE .vscodeignore
recursive-include backend/tests *.py
recursive-include tests/fixtures *.tex
recursive-include examples *.tex *.toml
recursive-include docs *.md
prune examples/article/.localleaf_build
