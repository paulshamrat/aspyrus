{
  "name": "localleaf",
  "displayName": "LocalLeaf",
  "description": "Ultra-lightweight distraction-free LaTeX text editor",
  "version": "0.2.0",
  "publisher": "localleaf",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.cjs",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "localleaf.open",
        "title": "Edit Text (LocalLeaf)",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "localleaf.open",
          "when": "resourceExtname == .tex",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "localleaf.open",
          "when": "resourceExtname == .tex"
        }
      ]
    }
  },
  "scripts": {
    "bundle": "esbuild src/webview/editor.js --bundle --outfile=src/webview/bundle.js --format=iife --minify",
    "test": "node --test test/*.test.js",
    "package": "npm run bundle && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1"
  }
}
