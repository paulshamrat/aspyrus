# LaTeX intermediate build artifacts
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.fdb_latexmk
*.fls
*.toc
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
*-blx.bib
._tmp_*

# Deliverables (generated by Aspyrus, not tracked in git)
*.pdf
*.docx

# Incoming feedback, collaborator edits, and review archives
/feedback/*
!/feedback/.gitkeep
!/feedback/README.md
archive/

# Editor and temporary files
__pycache__/
.ruff_cache/
.aspyrus_build/
.localleaf_build/
/.vscode/
*.code-workspace
*~
*.swp
*.swo
.~lock.*#
.DS_Store
Thumbs.db

# Document and figure export provenance
.*-export.json

# Generated workflow reports and logs
/logs/

# Current paired-build manifest (generated)
/build_report.json

# Track revision summaries and organization provenance; supplied files and
# generated comparisons remain ignored until a verified milestone.
!/feedback/rev*/
/feedback/rev*/**
!/feedback/rev*/README.md
!/feedback/rev*/audit/
/feedback/rev*/audit/*
!/feedback/rev*/audit/checks/
/feedback/rev*/audit/checks/*
!/feedback/rev*/audit/checks/organization/
/feedback/rev*/audit/checks/organization/*
!/feedback/rev*/audit/checks/organization/*.md
!/feedback/rev*/audit/checks/organization/*.json
